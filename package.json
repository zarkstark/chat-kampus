{
    "name": "chat-kampus-dekstop",
    "version": "1.0.0",
    "description":  "aplikasi chat kampus",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win nsis"
    },
    "dependencies": {
        "socket.io": "4.8.1",
        "socket.io-client": "^4.8.1"
    },
    "devDependencies": {
        "electron": "^37.0.0",
        "electron-builder": "^26.0.0"
    },
    "build": {
        "appId": "id.kampus.chat",
        "productName": "Chat Kampus",
        "files": [
            "main.js",
            "preload.js",
            "index.html",
            "package.json"
        ],
        "win": {
            "target":   "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}